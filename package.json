  "keywords": [
    "caniuse",
    "browserslist"
  ],
  "authors": [
    "nyalab",
    "MoOx"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "dependencies": {
    "browserslist": "^4.0.0",
    "caniuse-lite": "^1.0.0",
    "lodash.memoize": "^4.1.2",
